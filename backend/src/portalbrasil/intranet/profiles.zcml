<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="portalbrasil.intranet"
    >

  <genericsetup:registerProfile
      name="base"
      title="Portal Brasil: Intranet - Configuração Base"
      description="Configuração base da Intranet."
      directory="profiles/base"
      post_handler="portalbrasil.intranet.setuphandlers.base.import_final_steps"
      />

  <genericsetup:registerProfile
      name="cmfdependencies"
      title="Portal Brasil: Intranet - Dependências CMF"
      description="Perfil de configuração genérica com dependências principais necessárias pelo CMF."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      for="plone.base.interfaces.IPloneSiteRoot"
      directory="profiles/cmfdependencies"
      />

  <genericsetup:registerProfile
      name="default"
      title="PortalBrasil: Intranet"
      description="Instalação da solução de Intranet utilizando Plone"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="restricted"
      title="PortalBrasil: Intranet (Restrito)"
      description="Configuração de autenticação obrigatória."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/restricted"
      />

  <genericsetup:registerProfile
      name="demo"
      title="PortalBrasil: Intranet (Conteúdo de Exemplo)"
      description="Conteúdo de exemplo para a Intranet"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/demo"
      pre_handler=".setuphandlers.demo.create_example_content"
      />

  <!-- Hide Uninstall Profile-->
  <utility
      factory=".factory.HiddenProfiles"
      name="portalbrasil.intranet"
      />

  <include package=".upgrades" />

</configure>
