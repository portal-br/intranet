{
  "schema": {
    "title": "PortalBrasil: Intranet",
    "description": "Intranet utilizando Plone",
    "type": "object",
    "definitions": {
      "workflows": {
        "oneOf": [
          {
            "const": "restricted",
            "title": "Requer autenticação"
          },
          {
            "const": "public",
            "title": "Acesso anônimo"
          }
        ]
      },
      "timezones": {
        "title": "Fuso horário",
        "type": "string",
        "default": "America/Sao_Paulo",
        "description": "A configuração de fuso horário padrão do portal. Os usuários poderão definir seu próprio fuso horário, se os fusos horários disponíveis estiverem definidos nas configurações de data e hora.",
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "America/Rio_Branco"
            ],
            "title": "Acre (America/Rio_Branco)"
          },
          {
            "type": "string",
            "enum": [
              "America/Noronha"
            ],
            "title": "Fernando de Noronha (America/Noronha)"
          },
          {
            "type": "string",
            "enum": [
              "America/Sao_Paulo"
            ],
            "title": "Brasília (America/Sao_Paulo)"
          },
          {
            "type": "string",
            "enum": [
              "America/Manaus"
            ],
            "title": "Manaus (America/Manaus)"
          },
          {
            "type": "string",
            "enum": [
              "UTC"
            ],
            "title": "UTC (UTC)"
          }
        ]
      }
    },
    "required": [
      "site_id",
      "title",
      "workflow"
    ],
    "properties": {
      "site_id": {
        "type": "string",
        "title": "Identificador da Intranet",
        "default": "Plone",
        "description": "Nome curto da Intranet. Deve ser único nessa instalação."
      },
      "title": {
        "type": "string",
        "title": "Título",
        "default": "Intranet",
        "description": "Um título curto para o site. Ele será mostrado como parte do título da janela do navegador em cada página."
      },
      "description": {
        "type": "string",
        "title": "Descrição da Intranet",
        "default": "Intranet da nossa instituição"
      },
      "site_logo": {
        "type": "string",
        "format": "data-url",
        "title": "Logo da Intranet"
      },
      "workflow": {
        "type": "string",
        "title": "Modo de Acesso",
        "$ref": "#/definitions/workflows",
        "default": "restricted"
      },
      "available_languages": {
        "type": "array",
        "title": "Idiomas disponíveis",
        "description": "Idiomas que estarão disponíveis. Se mais de um idioma for selecionado, o primeiro da lista será o idioma padrão.",
        "items": {"$ref": "#/definitions/languages"},
        "default": ["pt-br"]
      },
      "default_language": {
        "type": "string",
        "title": "Idioma",
        "default": "pt-br"
      },
      "portal_timezone": {"$ref": "#/definitions/timezones"},
      "authentication": {
        "title": "Authentication",
        "type": "object",
        "properties": {
          "provider" : {
            "type": "string",
            "title": "User authentication",
            "description": "Which authentication would be used?",
            "default": "internal",
            "oneOf": [
              { "const": "internal", "title": "Plone" },
              { "const": "keycloak", "title": "Keycloak" },
              { "const": "oidc", "title": "OIDC / OAuth2" },
              { "const": "authomatic-google", "title": "Social Login Google" },
              { "const": "authomatic-github", "title": "Social Login GitHub" }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "keycloak"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/keycloak"
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "oidc"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/oidc"
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "authomatic-github"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/authomatic-github"
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "authomatic-google"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/authomatic-google"
            }
          },
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "internal"
                }
              }
            },
            "then": {
              "properties": {},
              "required": []
            }
          },
          {
            "required": [
              "provider"
            ]
          }
        ]
      },
      "setup_content": {
        "type": "boolean",
        "title": "Conteúdo Base",
        "description": "Devemos criar a estrutura de conteúdo da Intranet durante a instalação?",
        "default": true
      },
      "demo_content": {
        "type": "boolean",
        "title": "Conteúdo de exemplo (Demo)",
        "description": "Devemos adicionar conteúdo de exemplo durante a criação do site?",
        "default": false
      }
    }
  },
  "uischema": {
    "site_id": {"ui:widget": "hidden"},
    "setup_content": {"ui:widget": "hidden"},
    "available_languages": {"ui:widget": "hidden"},
    "default_language": {"ui:widget": "hidden"}
  }
}
