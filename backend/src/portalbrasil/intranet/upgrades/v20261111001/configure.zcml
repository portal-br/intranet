<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <genericsetup:upgradeSteps
      profile="portalbrasil.intranet:base"
      source="20261021001"
      destination="20261111001"
      >
    <genericsetup:upgradeStep
        title="Apply the Plone 6.2.3 upgrade steps"
        description="Runs the pending upgrade steps of the Plone core profiles that changed in 6.2.3: CMFPlone, plone.app.querystring and plone.volto."
        handler=".upgrade_core"
        />
    <genericsetup:upgradeStep
        title="Upgrade the theme add-ons"
        description="Runs the pending upgrade steps of sc.voltolighttheme."
        handler=".upgrade_dependencies"
        />
  </genericsetup:upgradeSteps>

</configure>
